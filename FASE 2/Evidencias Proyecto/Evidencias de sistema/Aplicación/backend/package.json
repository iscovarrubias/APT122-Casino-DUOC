    "test:estudiante": "node tests/integracion/estudiante.integracion.js",
    "test:acceso": "node tests/integracion/acceso.integracion.js",
    "test:db": "node tests/integracion/jornada.integracion.js && node tests/integracion/estudiante.integracion.js && node tests/integracion/acceso.integracion.js",
    "migrar": "node database/migrar.js",
    "respaldo": "node database/respaldo.js",
