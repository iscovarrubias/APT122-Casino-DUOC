{
  "name": "casino-duoc-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Pruebas de punta a punta con Playwright para Casinos DUOC UC",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "reporte": "playwright show-report",
    "formato": "prettier --write \"pruebas/**/*.js\" \"soporte/**/*.js\" \"*.{js,json}\"",
    "formato:revisar": "prettier --check \"pruebas/**/*.js\" \"soporte/**/*.js\" \"*.{js,json}\""
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "pg": "^8.23.1",
    "prettier": "3.10.1"
  }
}
