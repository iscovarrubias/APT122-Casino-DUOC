{
  "name": "casino-duoc-backend",
  "version": "1.0.0",
  "description": "Backend del MVP - Plataforma de gestión del Casino DUOC UC (APT122)",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "seed": "node database/seed_sprint1.js",
    "seed:ventas": "node database/seed_ventas_simuladas.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:integracion": "node tests/integracion/jornada.integracion.js",
    "test:estudiante": "node tests/integracion/estudiante.integracion.js",
    "test:acceso": "node tests/integracion/acceso.integracion.js",
    "test:db": "node tests/integracion/jornada.integracion.js && node tests/integracion/estudiante.integracion.js && node tests/integracion/acceso.integracion.js",
    "test:bd": "node --test --test-concurrency=1 \"tests/bd/*.test.js\"",
    "test:rendimiento": "node --test --test-reporter=spec tests/bd/rendimiento.bd.test.js",
    "test:todo": "npm test && npm run test:db && npm run test:bd",
    "test:cov": "node --test --experimental-test-coverage --test-concurrency=1 --test-coverage-include=\"src/**\" --test-coverage-lines=80 \"tests/*.test.js\" \"tests/bd/*.test.js\" \"tests/integracion/*.js\"",
    "migrar": "node database/migrar.js",
    "respaldo": "node database/respaldo.js",
    "respaldo:verificar": "node database/verificar_respaldo.js",
    "formato": "prettier --write \"src/**/*.{js,json}\" \"tests/**/*.js\" \"database/**/*.js\" \"*.{js,json}\"",
    "formato:revisar": "prettier --check \"src/**/*.{js,json}\" \"tests/**/*.js\" \"database/**/*.js\" \"*.{js,json}\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.5",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "3.10.1"
  }
}
